load "UMFPACK64"
load "iovtk"

// ============================================================
// PARAMETROS FISICOS
// ============================================================
real wr = 0.066;
real R = 0.011;
real w = 1.0 * wr;
real dw = (2*R)/wr;
real h = 4 * w;
real xc = 0.5 * w;
real yc = 0.75 * h;
int meshSize = 50;
real ratio = h / w;
real mulabel = 100.0; 
real mu = mulabel * 1.0e-3;
real vin = 0.023;
real rhoF = 1000.0;
real rhoS = 1380.0;
real dt = 0.01;
int  Tmax = 500;
real eps = 1e-9;
real l = 0.6;
real Vl = 0;
real Vx = 0;
real g = 9.77;
real s = 0.05 * wr;
real t = 0;
int inside = 0;

// ============================================================
// MALLA
// ============================================================
mesh Mesh;
{
    border w1(t=0.,1.){ x=w*t;   y=0.;    label=1; };
    border w2(t=0.,1.){ x=w;     y=h*t;   label=2; };
    border w3(t=0.,1.){ x=w-w*t; y=h;     label=3; };
    border w4(t=0.,1.){ x=0.;    y=h-h*t; label=4; };
    border c(t=0,2*pi){ x=xc+R*cos(t); y=yc+R*sin(t); label=5; };
    Mesh = buildmesh(w1(meshSize) + w2(ratio*meshSize) + w3(meshSize)
                   + w4(ratio*meshSize) + c(3*meshSize));
}

// ============================================================
// ESPACIOS
// ============================================================
fespace Vh(Mesh, P2);
fespace Ph(Mesh, P1);
fespace Sh(Mesh, P1);
fespace Dh(Mesh, P1);

Vh ux, uy, vx, vy, uxOld, uyOld, umag;
Ph p, q, fpfield, fmufield;
Sh chiB, rho;
Dh dmesh, vdmesh, umeshx;
umeshx = 0;

// ============================================================
// STOKES INICIAL
// ============================================================
macro Ddu(a,b,c,d) (
    2*dx(a)*dx(c) + 2*dy(b)*dy(d)
  + (dy(a)+dx(b))*(dy(c)+dx(d))
) // EOM

problem Stokes([ux, uy, p], [vx, vy, q], solver=UMFPACK)
    =   int2d(Mesh)( mu*(dx(ux)*dx(vx)+dy(ux)*dy(vx)
                       + dx(uy)*dx(vy)+dy(uy)*dy(vy)) )
    -   int2d(Mesh)( p*(dx(vx)+dy(vy)) )
    -   int2d(Mesh)( q*(dx(ux)+dy(uy)) )
    +   int2d(Mesh)( 1e-10*p*q )
    +   on(2, ux=0, uy=-vin)
    +   on(3, ux=0, uy=-vin)
    +   on(4, ux=0, uy=-vin)
    +   on(5, ux=0, uy=0);

Stokes;
real pMedia = int2d(Mesh)(p) / int2d(Mesh)(1.0);
p[] -= pMedia;
umag = sqrt(ux^2 + uy^2);

Mesh = adaptmesh(Mesh,
                 umag, p,
                 err   = 0.05,
                 hmin  = R/50,
                 hmax  = h/10,
                 ratio = 1.5,
                 nbvx  = 100000);

ux = ux; uy = uy; p = p;
Stokes;

umag = sqrt(ux^2 + uy^2);

cout << "Stokes resuelto. Vin=" << vin
     << "; dt=" << dt
     << "; rhoS=" << rhoS
     << "; N=" << meshSize
     << "; Tmax=" << Tmax << endl;

// ============================================================
// ARCHIVOS DE SALIDA
// ============================================================
string outputFileName = "../data/rawSim/vtu/" + dw + "_" + rhoS + "_" + vin + "_" + mulabel + ".txt";
string boundaryDir    = "../data/rawSim/vtu/" + dw + "_" + rhoS + "_" + vin + "_" + mulabel;

system("mkdir -p " + boundaryDir);

ofstream pvd(boundaryDir + "/simulation.pvd");
pvd << "<?xml version=\"1.0\"?>" << endl;
pvd << "<VTKFile type=\"Collection\" version=\"0.1\" byte_order=\"LittleEndian\">" << endl;
pvd << "  <Collection>" << endl;

ofstream out(outputFileName);
out << "t x vx Fp Fmu Fg" << endl;

// ============================================================
// CAMPOS INICIALES
// ============================================================
chiB = ( (x-xc)^2+(y-yc)^2 <= R^2 ) ? 1.0 : 0.0;
rho  = rhoF*(1.0-chiB) + rhoS*chiB;

// ============================================================
// BUCLE TEMPORAL
// ============================================================
for (int n = 0; n < Tmax; n++) {

    uxOld = ux;
    uyOld = uy;

    t += dt;

    real fxResorte = -rhoS * g * (xc - w/2.0) / l;

    problem NavierStokes([ux, uy, p], [vx, vy, q], solver=UMFPACK)
        =   int2d(Mesh)( (rho/dt)*(ux*vx+uy*vy) )
        +   int2d(Mesh)( mu*Ddu(ux,uy,vx,vy) )
        +   int2d(Mesh)( (mu/eps)*chiB*Ddu(ux,uy,vx,vy) )
        +   int2d(Mesh)( (1.0/eps)*chiB*uy*vy )
        -   int2d(Mesh)( p*(dx(vx)+dy(vy)) )
        -   int2d(Mesh)( q*(dx(ux)+dy(uy)) )
        +   int2d(Mesh)( 1e-10*p*q )
        -   int2d(Mesh)( (rho/dt)*(
                convect([uxOld-umeshx, uyOld], -dt, uxOld)*vx
              + convect([uxOld-umeshx, uyOld], -dt, uyOld)*vy ))
        + int2d(Mesh)( chiB * fxResorte * vx )
        +   on(1, ux=0, uy=-vin)
        +   on(2, ux=0, uy=-vin)
        +   on(3, ux=0, uy=-vin)
        +   on(4, ux=0, uy=-vin);

    NavierStokes;

    real pMed = int2d(Mesh)(p) / int2d(Mesh)(1.0);
    p[] -= pMed;

    real areaB = int2d(Mesh)(chiB);
    real Vl    = int2d(Mesh)(ux*chiB) / areaB;

    // Fuerzas integradas
    real Fp = int1d(Mesh, 5)(
        (-p) * (x - xc) / R
        );

    real Fmu = int1d(Mesh, 5)(
        (2*mu*dx(ux)) * (x - xc) / R
        + mu*(dy(ux) + dx(uy)) * (y - yc) / R
        );

    real Fhidro = Fp + Fmu;

    // Proyectar integrandos y coordenadas sobre la malla completa (P1)
    fpfield  = p;
    fmufield = (2*mu*dx(ux)) * (x - xc) / R
              + mu*(dy(ux) + dx(uy)) * (y - yc) / R;

    Ph xcoord = x;
    Ph ycoord = y;

    // Guardar distribucion nodal en frontera label=5
    {
        ofstream outB(boundaryDir + "/n" + n + ".txt");
        outB << "x y fp fmu" << endl;

        int[int] visited(Mesh.nv);
        for (int i = 0; i < Mesh.nv; i++) visited[i] = 0;

        for (int i = 0; i < Mesh.nbe; i++) {
            if (Mesh.be(i).label == 5) {
                for (int j = 0; j < 2; j++) {
                    int v = Mesh.be(i)[j];
                    if (visited[v] == 0) {
                        outB << xcoord[][v] << " " << ycoord[][v] << " "
                             << fpfield[][v]  << " "
                             << fmufield[][v] << endl;
                        visited[v] = 1;
                    }
                }
            }
        }
    }

    real Fg = fxResorte*int2d(Mesh)(chiB);

    // Guardar escalar en archivo principal
    out << t << " " << xc << " " << Vx << " " << Fp << " " << Fmu << " " << Fg << endl;

    Vx += Fhidro * dt;
    xc  = xc + dt * Vx;

    varf vPoisson(dmesh, vdmesh)
        =   int2d(Mesh)( dx(dmesh)*dx(vdmesh) + dy(dmesh)*dy(vdmesh) )
        +   on(5, dmesh=Vx*dt)
        +   on(1,2,3,4, dmesh=0);

    matrix PoissonMat = vPoisson(Dh, Dh);
    set(PoissonMat, solver=UMFPACK);
    real[int] PoissonRHS = vPoisson(0, Dh);
    dmesh[] = PoissonMat^-1 * PoissonRHS;

    umeshx = dmesh / dt;
    Mesh   = movemesh(Mesh, [x + dmesh, y]);

    chiB = ( (x-xc)^2+(y-yc)^2 < R^2 ) ? 1.0 : 0.0;
    rho  = rhoF*(1.0-chiB) + rhoS*chiB;

    ux = ux; uy = uy; p = p;
    uxOld = uxOld; uyOld = uyOld;
    umeshx = umeshx; dmesh = dmesh;
    fpfield = fpfield; fmufield = fmufield;

    // Actualizar umag tras movemesh para CFL correcto
    umag = sqrt(ux^2 + uy^2);

    inside = ((xc-R) < 1.5*s || (xc+R) > (w-1.5*s)) ? 1 : 0;

    if (n > 0) {
        real hTri = int2d(Mesh)(hTriangle) / int2d(Mesh)(1.0);
        if (inside == 1)
            dt = 0.2 * hTri / (umag[].max + 1e-10);
        else
            dt = 0.5 * hTri / (umag[].max + 1e-10);
        dt = min(dt, 0.5);
        dt = max(dt, 1e-5);
    }

    real Co = umag[].max * dt / (int2d(Mesh)(hTriangle) / int2d(Mesh)(1.0));

    cout << "n=" << n
         << "  xc/w=" << xc/w
         << "  Vx=" << Vx
         << "  Vl=" << Vl
         << "  Fg=" << Fg
         << "  Fp=" << Fp
         << "  Fmu=" << Fmu
         << "  Co=" << Co
         << "  dt=" << dt
         << "  inside=" << inside << endl;

    // Guardar VTU en carpeta boundary
    int[int] orderOut = [1, 1, 1, 1, 1, 1];
    savevtk(boundaryDir + "/n" + n + ".vtu", Mesh,
            ux, uy, [ux, uy, 0], dmesh, p, chiB,
            dataname="ux uy vector d pressure cylinder",
            order=orderOut);
        
    pvd << "    <DataSet timestep=\"" << t << "\" group=\"\" part=\"0\" file=\"n" << n << ".vtu\"/>" << endl;
}

pvd << "  </Collection>" << endl;
pvd << "</VTKFile>" << endl;